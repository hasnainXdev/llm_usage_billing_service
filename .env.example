# --- Database ---
# postgresql://user:password@host:port/database
DATABASE_URL=postgresql://flyrank:flyrank@localhost:5432/flyrank

# --- Stripe (TEST MODE ONLY, forever) ---
# Test-mode key from https://dashboard.stripe.com/test/apikeys  (sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret from:  stripe listen --forward-to localhost:8000/webhooks/stripe
# (whsec_...). Copy the printed line into .env.
STRIPE_WEBHOOK_SECRET=whsec_xxx
